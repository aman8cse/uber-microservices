# Shared project settings
# Copy this file to .env in each service and fill in the real values.

PORT=3001
MONGO_URI=mongodb://localhost:27017/uber-user
JWT_SECRET=replace_with_a_long_random_secret
AMQP_URL=amqp://localhost
USER_SERVICE_URL=http://localhost:3001

# Example service-specific values
# user/.env -> PORT=3001, MONGO_URI=mongodb://localhost:27017/uber-user
# captain/.env -> PORT=3002, MONGO_URI=mongodb://localhost:27017/uber-captain
# ride/.env -> PORT=3003, MONGO_URI=mongodb://localhost:27017/uber-ride
# gateway/.env -> optional, if later extended for external config
